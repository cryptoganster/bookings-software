# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=3005

# ============================================
# Database Configuration
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-database-password
DB_DATABASE=bookings_dev

# ============================================
# JWT Authentication
# ============================================
# Generate secure secret: openssl rand -base64 32
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRATION=1d

# ============================================
# WhatsApp Business API Configuration
# ============================================
# 
# Setup Instructions:
# 1. Create Meta Developer Account: https://developers.facebook.com
# 2. Create WhatsApp Business App in Meta Dashboard
# 3. Add WhatsApp product to your app
# 4. Get credentials from WhatsApp → API Setup page
#
# For detailed setup guide, see:
# .kiro/specs/conversation-enhancements/whatsapp-setup-guide.md
#
# For Testing (Development):
# - Use temporary access token (expires in 24 hours)
# - Use test phone numbers provided by Meta (free, no real phone needed)
# - Test numbers available in API Setup → "Send and receive messages" section
#
# For Production:
# - Complete Business Verification (required)
# - Create System User and generate permanent token
# - Use production phone number

# WhatsApp API Base URL
# Format: https://graph.facebook.com/{version}/{phone-number-id}/
# Get phone-number-id from: WhatsApp → API Setup → "Phone number ID"
# Current version: v22.0 (check Meta docs for latest)
WHATSAPP_API_URL=https://graph.facebook.com/v22.0/YOUR_PHONE_NUMBER_ID/

# WhatsApp Access Token
# Development: Use temporary token from API Setup (valid 24 hours)
# Production: Generate permanent token via System User
# Get from: WhatsApp → API Setup → "Temporary access token" button
# IMPORTANT: Keep this secret! Never commit to version control
WHATSAPP_ACCESS_TOKEN=your-access-token-here

# Phone Number ID
# Get from: WhatsApp → API Setup → "Phone number ID"
# This is NOT your phone number, it's the ID assigned by Meta
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# WhatsApp Business Account ID
# Get from: WhatsApp → API Setup → "WhatsApp Business Account ID"
# Used for some API calls and webhook configuration
WHATSAPP_BUSINESS_ACCOUNT_ID=your-business-account-id

# Webhook Verify Token
# Generate a random secure string: openssl rand -hex 32
# Use this same token when configuring webhook in Meta Dashboard
# Meta will send this token to verify your webhook endpoint
# IMPORTANT: Keep this secret! Never commit to version control
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your-secure-random-verify-token-here

# Webhook Secret (App Secret)
# Get from: App Dashboard → Settings → Basic → "App Secret"
# Used to validate webhook signature for security
# IMPORTANT: Keep this secret! Never commit to version control
WHATSAPP_WEBHOOK_SECRET=your-app-secret-here

# ============================================
# Logging Configuration
# ============================================
# Options: error, warn, info, debug
LOG_LEVEL=debug

# ============================================
# Testing Configuration (Optional)
# ============================================
#
# For local development testing:
# 1. Use ngrok or similar to expose local server: ngrok http 3005
# 2. Copy ngrok URL and configure in Meta Dashboard
# 3. Webhook URL format: https://your-ngrok-url.ngrok.io/api/webhooks/whatsapp
# 4. Use test phone numbers from Meta (no real phone needed)
#
# Test Phone Numbers:
# - Available in: WhatsApp → API Setup → "Send and receive messages"
# - Free to use in development mode
# - Can send/receive messages without cost
# - Limited to development environment only
#
# Mock Client for Unit Tests:
# - Use MockWhatsAppClient in tests (no API calls)
# - Located in: src/conversation/infra/external/__mocks__/
# - No credentials needed for unit tests

# ============================================
# Redis Configuration (Optional - for WebSocket scaling)
# ============================================
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your-redis-password

# ============================================
# Media Storage Configuration (Optional)
# ============================================
# MEDIA_STORAGE_PATH=./uploads
# MEDIA_MAX_FILE_SIZE_MB=10
# MEDIA_ALLOWED_MIME_TYPES=image/jpeg,image/png,application/pdf

# ============================================
# Email Configuration (Optional - for team member invitations)
# ============================================
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-email-password
# EMAIL_FROM=noreply@yourdomain.com
