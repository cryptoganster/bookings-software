import { DataSource } from 'typeorm';
import { TestBlockoutHelper, createBlockoutInDb } from '../availability/blockout';
import { TestBusinessHelper } from '../business';
import { TestDatabaseHelper } from '../database';
import { BlockoutModel } from '../../../availability/infra/persistence/models/blockout.model';

describe('TestBlockoutHelper', () => {
  let dataSource: DataSource;
  let blockoutHelper: TestBlockoutHelper;
  let businessHelper: TestBusinessHelper;
  let databaseHelper: TestDatabaseHelper;

  beforeAll(async () => {
    dataSource = await TestDatabaseHelper.createTestDataSource();
    await dataSource.initialize();
  });

  afterAll(async () => {
    await dataSource?.destroy();
  });

  beforeEach(async () => {
    blockoutHelper = new TestBlockoutHelper(dataSource);
    businessHelper = new TestBusinessHelper(dataSource);
    databaseHelper = new TestDatabaseHelper(dataSource);
    await databaseHelper.cleanDatabase();
  });

  afterEach(async () => {
    await blockoutHelper.cleanup();
    await businessHelper.cleanup();
  });

  describe('createBlockout', () => {
    it('should create a blockout with default values', async () => {
      const business = await businessHelper.createBusiness();
      const blockout = await blockoutHelper.createBlockout({ businessId: business.id });

      expect(blockout).toBeDefined();
      expect(blockout.id).toBeDefined();
      expect(blockout.businessId).toBe(business.id);
      expect(blockout.startDate).toBeInstanceOf(Date);
      expect(blockout.endDate).toBeInstanceOf(Date);
      expect(blockout.reason).toBe('Test blockout');
    });

    it('should create a blockout with custom dates', async () => {
      const business = await businessHelper.createBusiness();
      const startDate = new Date('2025-12-25');
      const endDate = new Date('2025-12-26');

      const blockout = await blockoutHelper.createBlockout({
        businessId: business.id,
        startDate,
        endDate,
        reason: 'Christmas holiday',
      });

      expect(blockout.startDate.toISOString()).toBe(startDate.toISOString());
      expect(blockout.endDate.toISOString()).toBe(endDate.toISOString());
      expect(blockout.reason).toBe('Christmas holiday');
    });

    it('should track created blockouts for cleanup', async () => {
      const business = await businessHelper.createBusiness();
      await blockoutHelper.createBlockout({ businessId: business.id });
      await blockoutHelper.createBlockout({
        businessId: business.id,
        reason: 'Another blockout',
      });

      const repo = dataSource.getRepository(BlockoutModel);
      const blockouts = await repo.find({ where: { businessId: business.id } });
      expect(blockouts).toHaveLength(2);

      await blockoutHelper.cleanup();

      const blockoutsAfterCleanup = await repo.find({ where: { businessId: business.id } });
      expect(blockoutsAfterCleanup).toHaveLength(0);
    });

    it('should persist blockout to database', async () => {
      const business = await businessHelper.createBusiness();
      const blockout = await blockoutHelper.createBlockout({ businessId: business.id });

      const repo = dataSource.getRepository(BlockoutModel);
      const found = await repo.findOne({ where: { id: blockout.id } });

      expect(found).toBeDefined();
      expect(found?.id).toBe(blockout.id);
      expect(found?.businessId).toBe(business.id);
    });
  });

  describe('createBlockoutInDb', () => {
    it('should create a blockout directly in database', async () => {
      const business = await businessHelper.createBusiness();
      const blockout = await createBlockoutInDb(dataSource, { businessId: business.id });

      expect(blockout).toBeDefined();
      expect(blockout.id).toBeDefined();
      expect(blockout.businessId).toBe(business.id);

      const repo = dataSource.getRepository(BlockoutModel);
      const found = await repo.findOne({ where: { id: blockout.id } });
      expect(found).toBeDefined();
    });

    it('should create blockout with custom reason', async () => {
      const business = await businessHelper.createBusiness();
      const blockout = await createBlockoutInDb(dataSource, {
        businessId: business.id,
        reason: 'Vacation',
      });

      expect(blockout.reason).toBe('Vacation');
    });
  });

  describe('cleanup', () => {
    it('should remove all created blockouts', async () => {
      const business = await businessHelper.createBusiness();
      const blockout1 = await blockoutHelper.createBlockout({ businessId: business.id });
      const blockout2 = await blockoutHelper.createBlockout({
        businessId: business.id,
        reason: 'Another blockout',
      });

      const repo = dataSource.getRepository(BlockoutModel);
      let blockouts = await repo.find({
        where: [{ id: blockout1.id }, { id: blockout2.id }],
      });
      expect(blockouts).toHaveLength(2);

      await blockoutHelper.cleanup();

      blockouts = await repo.find({
        where: [{ id: blockout1.id }, { id: blockout2.id }],
      });
      expect(blockouts).toHaveLength(0);
    });

    it('should handle cleanup when no blockouts exist', async () => {
      await expect(blockoutHelper.cleanup()).resolves.not.toThrow();
    });

    it('should handle cleanup errors gracefully', async () => {
      const business = await businessHelper.createBusiness();
      await blockoutHelper.createBlockout({ businessId: business.id });

      // Close connection to simulate error
      await dataSource.destroy();

      await expect(blockoutHelper.cleanup()).resolves.not.toThrow();
    });
  });

  describe('date range blockouts', () => {
    it('should create blockout spanning multiple days', async () => {
      const business = await businessHelper.createBusiness();
      const startDate = new Date('2025-12-20');
      const endDate = new Date('2025-12-31');

      const blockout = await blockoutHelper.createBlockout({
        businessId: business.id,
        startDate,
        endDate,
        reason: 'Year-end holidays',
      });

      expect(blockout.startDate.toISOString()).toBe(startDate.toISOString());
      expect(blockout.endDate.toISOString()).toBe(endDate.toISOString());

      const daysDiff = Math.ceil(
        (blockout.endDate.getTime() - blockout.startDate.getTime()) / (1000 * 60 * 60 * 24),
      );
      expect(daysDiff).toBe(11);
    });

    it('should create single-day blockout', async () => {
      const business = await businessHelper.createBusiness();
      const date = new Date('2025-12-25');

      const blockout = await blockoutHelper.createBlockout({
        businessId: business.id,
        startDate: date,
        endDate: date,
        reason: 'Christmas Day',
      });

      expect(blockout.startDate.toISOString()).toBe(date.toISOString());
      expect(blockout.endDate.toISOString()).toBe(date.toISOString());
    });
  });
});
