{
  "name": "@bookings/monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema de Reservas Multi-Tenant - Monorepo",
  "scripts": {
    "dev": "pnpm --parallel --stream run dev",
    "dev:backend": "pnpm --filter backend run start:dev",
    "dev:frontend": "pnpm --filter frontend run dev",
    "build": "pnpm --recursive run build",
    "build:backend": "pnpm --filter backend run build",
    "build:frontend": "pnpm --filter frontend run build",
    "test": "pnpm --recursive run test",
    "test:backend": "pnpm --filter backend run test",
    "test:frontend": "pnpm --filter frontend run test",
    "test:backend:watch": "pnpm --filter backend run test:watch",
    "test:frontend:watch": "pnpm --filter frontend run test:watch",
    "test:backend:coverage": "pnpm --filter backend run test:cov",
    "test:frontend:coverage": "pnpm --filter frontend run test:coverage",
    "test:frontend:ui": "pnpm --filter frontend run test:ui",
    "test:backend:e2e": "pnpm --filter backend run test:e2e",
    "typecheck": "pnpm --recursive run typecheck",
    "typecheck:backend": "pnpm --filter backend run typecheck",
    "typecheck:frontend": "pnpm --filter frontend run typecheck",
    "lint": "pnpm --recursive run lint",
    "lint:backend": "pnpm --filter backend run lint",
    "lint:frontend": "pnpm --filter frontend run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "lint:backend:fix": "pnpm --filter backend run lint:fix",
    "lint:frontend:fix": "pnpm --filter frontend run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:backend": "pnpm --filter backend run format",
    "format:frontend": "pnpm --filter frontend run format",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "clean": "pnpm --recursive run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "prettier": "^3.1.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}
