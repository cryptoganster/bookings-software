#!/usr/bin/env bash

# Pre-push safety hook - Blocks dangerous push operations and enforces rebase strategy
# This runs BEFORE the main pre-push hook

set -e

# Get the command line arguments
# $1 = remote name (e.g., "origin")
# $2 = remote URL

remote_name="$1"
remote_url="$2"

# Get current branch
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Skip checks for master branch (should never push to master directly anyway)
if [ "$current_branch" = "master" ]; then
  exit 0
fi

# Check 0: Verify working directory is clean (NO uncommitted changes)
echo "🔍 Checking for uncommitted changes..."

# Check for uncommitted changes (staged or unstaged)
if ! git diff-index --quiet HEAD --; then
  echo ""
  echo "❌ ERROR: You have uncommitted changes!"
  echo ""
  echo "🚫 BLOCKED: Cannot push with uncommitted changes"
  echo ""
  echo "For safety, you MUST commit all changes before pushing."
  echo "This prevents accidental loss of work during rebase."
  echo ""
  echo "📋 Uncommitted changes:"
  git status --short
  echo ""
  echo "✅ REQUIRED STEPS:"
  echo "   1. Review your changes:"
  echo "      git status"
  echo "      git diff"
  echo ""
  echo "   2. Stage your changes:"
  echo "      git add <files>"
  echo "      # or stage all: git add ."
  echo ""
  echo "   3. Commit your changes:"
  echo "      git commit -m 'feat: your description'"
  echo ""
  echo "   4. Then push again:"
  echo "      git push origin $current_branch"
  echo ""
  echo "⚠️  IMPORTANT: Do NOT use 'git stash' or discard changes!"
  echo "    All work must be committed to ensure it's not lost."
  echo ""
  exit 1
fi

# Check for untracked files
untracked_files=$(git ls-files --others --exclude-standard)
if [ -n "$untracked_files" ]; then
  echo ""
  echo "⚠️  WARNING: You have untracked files"
  echo ""
  echo "These files are not in Git and won't be pushed:"
  echo "$untracked_files" | sed 's/^/  - /'
  echo ""
  echo "💡 If these files should be tracked:"
  echo "   1. Add them: git add <files>"
  echo "   2. Commit them: git commit -m 'feat: add new files'"
  echo "   3. Push again: git push origin $current_branch"
  echo ""
  echo "💡 If these files should be ignored:"
  echo "   1. Add them to .gitignore"
  echo "   2. Commit .gitignore: git commit -m 'chore: update gitignore'"
  echo ""
  
  # Ask user if they want to continue
  read -p "Continue push without these files? (y/N): " -n 1 -r
  echo ""
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Push cancelled. Please handle untracked files first."
    exit 1
  fi
fi

echo "✅ Working directory is clean"

# Check 1: Verify pnpm-lock.yaml is in sync with package.json files
echo "🔍 Checking if pnpm-lock.yaml is in sync..."

# Check if pnpm-lock.yaml exists
if [ -f "pnpm-lock.yaml" ]; then
  # Run pnpm install --lockfile-only in dry-run mode to check if lockfile would change
  # This is fast and doesn't install anything
  if ! pnpm install --lockfile-only --frozen-lockfile &>/dev/null; then
    echo ""
    echo "❌ ERROR: pnpm-lock.yaml is out of sync with package.json files!"
    echo ""
    echo "🚫 BLOCKED: Lockfile needs to be updated"
    echo ""
    echo "This usually happens when:"
    echo "  - Dependencies were added/updated in package.json"
    echo "  - Dependabot updated a package but not the lockfile"
    echo "  - Manual edits to package.json without running pnpm install"
    echo ""
    echo "✅ REQUIRED STEPS:"
    echo "   1. Update the lockfile:"
    echo "      pnpm install"
    echo ""
    echo "   2. Commit the updated lockfile:"
    echo "      git add pnpm-lock.yaml"
    echo "      git commit -m 'chore: update pnpm-lock.yaml'"
    echo ""
    echo "   3. Push again:"
    echo "      git push origin $current_branch"
    echo ""
    exit 1
  fi
fi

echo "✅ pnpm-lock.yaml is in sync"

# Check 2: Verify branch is rebased on latest origin/master
echo "🔍 Checking if branch is rebased on latest origin/master..."

# Fetch latest master silently
git fetch origin master --quiet 2>/dev/null || true

# Get merge base between current branch and origin/master
merge_base=$(git merge-base HEAD origin/master 2>/dev/null || echo "")
origin_master_sha=$(git rev-parse origin/master 2>/dev/null || echo "")

if [ -n "$merge_base" ] && [ -n "$origin_master_sha" ]; then
  if [ "$merge_base" != "$origin_master_sha" ]; then
    commits_behind=$(git rev-list --count $merge_base..origin/master)
    
    echo ""
    echo "❌ Branch is not rebased on latest origin/master!"
    echo ""
    echo "Current state:"
    echo "  Your branch base: $(git rev-parse --short $merge_base)"
    echo "  Latest master:    $(git rev-parse --short $origin_master_sha)"
    echo "  Commits behind:   $commits_behind"
    echo ""
    
    # Offer auto-rebase
    echo "🤖 AUTO-REBASE AVAILABLE"
    echo ""
    echo "I can automatically rebase your branch on origin/master."
    echo ""
    echo "⚠️  IMPORTANT:"
    echo "  - Your working directory is clean (verified above)"
    echo "  - If conflicts occur, you'll need to resolve them"
    echo "  - After rebase, you'll need to force-push"
    echo ""
    read -p "Do you want to auto-rebase now? (y/N): " -n 1 -r
    echo ""
    
    if [[ $REPLY =~ ^[Yy]$ ]]; then
      echo ""
      echo "🔄 Starting auto-rebase..."
      echo ""
      
      # Perform rebase
      if git rebase origin/master; then
        echo ""
        echo "✅ Rebase successful!"
        echo ""
        echo "📝 NEXT STEPS:"
        echo "   Your branch has been rebased on origin/master."
        echo "   Now you need to push with force-with-lease:"
        echo ""
        echo "   git push --force-with-lease origin $current_branch"
        echo ""
        echo "⚠️  Note: This push was cancelled to let you review the rebase."
        echo "   Run the push command above when ready."
        echo ""
        exit 1
      else
        echo ""
        echo "❌ Rebase failed with conflicts!"
        echo ""
        echo "🔧 CONFLICT RESOLUTION STEPS:"
        echo "   1. Open conflicted files and resolve conflicts"
        echo "   2. Stage resolved files: git add <files>"
        echo "   3. Continue rebase: git rebase --continue"
        echo "   4. If you want to abort: git rebase --abort"
        echo ""
        echo "After resolving conflicts, push with:"
        echo "   git push --force-with-lease origin $current_branch"
        echo ""
        exit 1
      fi
    else
      echo ""
      echo "🚫 BLOCKED: Manual rebase required"
      echo ""
      echo "✅ MANUAL REBASE STEPS:"
      echo "   1. Rebase your branch:"
      echo "      git rebase origin/master"
      echo ""
      echo "   2. If conflicts occur:"
      echo "      # Edit conflicted files"
      echo "      git add <resolved-files>"
      echo "      git rebase --continue"
      echo ""
      echo "   3. Push with force-with-lease:"
      echo "      git push --force-with-lease origin $current_branch"
      echo ""
      exit 1
    fi
  fi
fi

# Check 3: Block force push without --force-with-lease
# Read the push details from stdin
# Format: <local ref> <local sha1> <remote ref> <remote sha1>
while read local_ref local_sha remote_ref remote_sha; do
  # Extract branch name from refs/heads/branch-name
  branch_name=$(echo "$remote_ref" | sed 's|refs/heads/||')
  
  # Check if this is a force push (--force)
  # Git passes this info via the refspec, but we can detect it by checking
  # if the remote SHA is not an ancestor of the local SHA
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    # Check if this would be a force push
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      # Check if --force-with-lease was used (safer)
      # Unfortunately, we can't detect this in the hook, so we block all force pushes
      # and recommend --force-with-lease
      
      echo ""
      echo "❌ ERROR: Force push detected!"
      echo ""
      echo "🚫 BLOCKED OPERATION: git push --force"
      echo ""
      echo "Force pushes are dangerous and can overwrite others' work."
      echo ""
      echo "✅ SAFE ALTERNATIVE:"
      echo "   git push --force-with-lease origin $branch_name"
      echo ""
      echo "This ensures you don't overwrite changes you haven't seen."
      echo ""
      echo "If you're absolutely sure (e.g., after a rebase):"
      echo "   1. Verify no one else pushed: git fetch origin"
      echo "   2. Use: git push --force-with-lease origin $branch_name"
      echo ""
      exit 1
    fi
  fi
done

echo "✅ Branch is properly rebased on origin/master"
exit 0
