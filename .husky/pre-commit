#!/usr/bin/env bash

# Pre-commit hook - Runs all validation checks
# To bypass: git commit --no-verify (NOT RECOMMENDED)

set -e

echo "🚀 Running pre-commit checks..."
echo ""

# 1. File size check
echo "📏 Step 1/3: Checking file sizes..."
bash scripts/pre-commit-filesize.sh
echo ""

# 2. Secret scanning
echo "🔍 Step 2/3: Scanning for secrets..."
bash scripts/pre-commit-secrets.sh
echo ""

# 3. Lint-staged (ESLint, Prettier, TypeScript)
echo "🔧 Step 3/3: Running lint-staged (ESLint, Prettier, TypeScript)..."
pnpm exec lint-staged
echo ""

echo "✅ All pre-commit checks passed!"
echo ""
