#!/usr/bin/env bash

# Pre-push hook - Runs lint, typecheck, and format before push
# To bypass: git push --no-verify (NOT RECOMMENDED)

set -e

echo "🚀 Running pre-push checks..."
echo ""

# 1. Format (auto-fix)
echo "💅 Step 1/4: Auto-formatting code..."
pnpm format
echo ""

# 2. Lint
echo "🔍 Step 2/4: Running lint..."
pnpm lint
echo ""

# 3. Typecheck
echo "📘 Step 3/4: Running typecheck..."
pnpm typecheck
echo ""

# 4. Format check (verify)
echo "✅ Step 4/4: Verifying format..."
pnpm format:check
echo ""

echo "✅ All checks passed! Pushing to remote..."
echo ""
