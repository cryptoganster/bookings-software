#!/usr/bin/env bash

# Pre-push hook - Runs lint, typecheck, and format before push
# To bypass: git push --no-verify (NOT RECOMMENDED)

set -e

echo "🚀 Running pre-push checks..."
echo ""

# 1. Lint
echo "� Step 1/3: Running lint..."
pnpm lint
echo ""

# 2. Typecheck
echo "📘 Step 2/3: Running typecheck..."
pnpm typecheck
echo ""

# 3. Format check
echo "💅 Step 3/3: Checking format..."
pnpm format:check
echo ""

echo "✅ All checks passed! Pushing to remote..."
echo ""
